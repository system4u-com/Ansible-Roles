---
# Opt-in API profiles; thresholds are starting budgets, not protocol requirements.
http:
  middlewares:
    api-security-headers:
      headers:
        contentTypeNosniff: true
        frameDeny: true
        referrerPolicy: no-referrer
        permissionsPolicy: "accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()"
        stsSeconds: 31536000
        stsIncludeSubdomains: false
        stsPreload: false
        customResponseHeaders:
          Server: ""
    rest-api-body-limit:
      buffering:
        maxRequestBodyBytes: 1048576
        memRequestBodyBytes: 131072
        maxResponseBodyBytes: 16777216
        memResponseBodyBytes: 131072
    rest-api-rate-limit:
      rateLimit:
        average: 60
        period: 1m
        burst: 20
    rest-api-inflight-limit:
      inFlightReq:
        amount: 20
        sourceCriterion:
          requestHost: true
    mcp-api-rate-limit:
      rateLimit:
        average: 600
        period: 1m
        burst: 120
    mcp-api-inflight-limit:
      inFlightReq:
        amount: 100
        sourceCriterion:
          requestHost: true
    agent-api-rate-limit:
      rateLimit:
        average: 120
        period: 1m
        burst: 30
    agent-api-inflight-limit:
      inFlightReq:
        amount: 20
        sourceCriterion:
          requestHost: true
    rest-api-chain:
      chain:
        middlewares:
          - api-security-headers
          - rest-api-rate-limit
          - rest-api-inflight-limit
          - rest-api-body-limit
    # No buffering, compression or retries: preserve SSE and never replay actions.
    mcp-api-chain:
      chain:
        middlewares:
          - api-security-headers
          - mcp-api-rate-limit
          - mcp-api-inflight-limit
    agent-api-chain:
      chain:
        middlewares:
          - api-security-headers
          - agent-api-rate-limit
          - agent-api-inflight-limit
